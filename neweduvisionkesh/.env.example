# EduVision Video Generator — example environment
# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model used for lesson planning and Manim code generation
# GROQ_MODEL=openai/gpt-oss-120b

# Server port for `npm run serve` (Render sets this automatically)
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For production add your Vercel URL:
#   FRONTEND_ORIGIN=https://eduvision-main.vercel.app,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Render-specific ───────────────────────────────────────────────────────
# Render automatically sets RENDER_EXTERNAL_URL to your service's public HTTPS URL.
# You do NOT need to set this manually — it is provided by Render's runtime.
# RENDER_EXTERNAL_URL=https://eduvision-backend.onrender.com

# ── Optional: TTS provider keys (added in a later stage) ─────────────────
# ELEVENLABS_API_KEY=
